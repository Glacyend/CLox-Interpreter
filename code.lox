fun greet(what, name) {
    if (name == nil) {
        print what + ", THE UNKNOWN!";
    } else {
        print what + ", " + name + "!";
    }
}

print "Enter your name here:";
var name = readline();

if (name == "") {
    greet("Hello", nil);
    greet("Goodbye", nil);
} else {
    greet("Hello", name);
    greet("Goodbye", name);
}
