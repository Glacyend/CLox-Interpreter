fun fib(n) {
    if (n < 2) {
        return n;
    }
    return fib(n - 1) + fib(n - 2);
}

print "Password:";
var password = readline();

if (password == "123456@abcdef") {
    print "Enter the program.";

    var start = clock();
    var result = fib(35);
    var end = clock();

    print "Result:";
    print result;
    print "Time (ms):";
    print (end - start) * 1000;
} else {
    print "Password incorrect.";
    print "The program exited.";
}
