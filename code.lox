var num = 15;

print "Target:";
print num;

var result;
if (num <= 2) {
    result = 1;
} else {
    var first = 1;
    var second = 1;
    for (var i = 3; i <= num; i = i + 1) {
        var temp = first;
        first = second;
        second = second + temp;
    }
    result = second;
}

print "Result:";
print result;
